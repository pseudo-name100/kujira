# Deployer key. Use a fresh wallet funded only with the ETH needed for gas.
PRIVATE_KEY=

# Optional RPC overrides
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_SEPOLIA_RPC_URL=https://rpc-gel-sepolia.inkonchain.com


# Receives the liquidity share (defaults to the deployer)
LIQUIDITY_ADDRESS=

# Receives the 1% Uniswap pool fees collected by KujiraLiquidityLock (required on Ink mainnet)
FEE_RECIPIENT=
